<?xml version="1.0" encoding="UTF-8" ?>
<precice-configuration experimental="true">
  <log>
    <sink
      filter="%Severity% > debug and %Rank% = 0"
      format="---[precice] %ColorizedSeverity% %Message%"
      enabled="true" />
  </log>

  <profiling mode="fundamental" synchronize="false" />

  <data:vector name="Velocity" />
  <data:scalar name="Pressure" />

  <mesh name="Fluid3DRight-Mesh" dimensions="3">
    <use-data name="Velocity" />
    <use-data name="Pressure" />
  </mesh>

  <mesh name="Fluid3DLeft-Mesh" dimensions="3">
    <use-data name="Velocity" />
    <use-data name="Pressure" />
  </mesh>

  <participant name="Fluid3DRight">
    <provide-mesh name="Fluid3DRight-Mesh" />
    <receive-mesh name="Fluid3DLeft-Mesh" from="Fluid3DLeft" api-access="false" />
    <write-data name="Pressure" mesh="Fluid3DRight-Mesh" />
    <read-data name="Velocity" mesh="Fluid3DRight-Mesh" />
    <mapping:nearest-neighbor
      direction="read"
      from="Fluid3DLeft-Mesh"
      to="Fluid3DRight-Mesh"
      constraint="consistent" />
    <export:vtu directory="precice-exports" />
  </participant>

  <participant name="Fluid3DLeft">
    <provide-mesh name="Fluid3DLeft-Mesh" />
    <receive-mesh name="Fluid3DRight-Mesh" from="Fluid3DRight" api-access="false" />
    <read-data name="Pressure" mesh="Fluid3DLeft-Mesh" />
    <write-data name="Velocity" mesh="Fluid3DLeft-Mesh" />
    <mapping:nearest-neighbor
      direction="read"
      from="Fluid3DRight-Mesh"
      to="Fluid3DLeft-Mesh"
      constraint="consistent" />
    <export:vtu directory="precice-exports" />
  </participant>

  <m2n:sockets acceptor="Fluid3DRight" connector="Fluid3DLeft" exchange-directory=".." />

  <coupling-scheme:parallel-implicit>
    <time-window-size value="0.01" />
    <max-time value="5.0" />
    <participants first="Fluid3DLeft" second="Fluid3DRight" />
    <exchange data="Velocity" mesh="Fluid3DLeft-Mesh" from="Fluid3DLeft" to="Fluid3DRight" />
    <exchange data="Pressure" mesh="Fluid3DRight-Mesh" from="Fluid3DRight" to="Fluid3DLeft" />
    <max-iterations value="100" />
    <relative-convergence-measure limit="1.0e-3" data="Velocity" mesh="Fluid3DLeft-Mesh" />
    <relative-convergence-measure limit="1.0e-3" data="Pressure" mesh="Fluid3DRight-Mesh" />
    <acceleration:IQN-ILS>
      <data mesh="Fluid3DLeft-Mesh" name="Velocity" />
      <data mesh="Fluid3DRight-Mesh" name="Pressure" />
      <preconditioner type="residual-sum" />
      <initial-relaxation value="1.0" />
      <max-used-iterations value="3" />
      <time-windows-reused value="10" />
      <filter type="QR1" limit="1e-6" />
    </acceleration:IQN-ILS>
  </coupling-scheme:parallel-implicit>
</precice-configuration>
