<?xml version="1.0" encoding="UTF-8" ?>
<precice-configuration experimental="true">
  <log>
    <sink
      filter="%Severity% > debug and %Rank% = 0"
      format="---[precice] %ColorizedSeverity% %Message%"
      enabled="true" />
  </log>

  <profiling mode="fundamental" synchronize="false" />

  <data:vector name="Velocity" />
  <data:scalar name="Pressure" />

  <mesh name="Fluid1DRight-Mesh" dimensions="3">
    <use-data name="Velocity" />
    <use-data name="Pressure" />
  </mesh>

  <mesh name="Fluid1DLeft-Mesh" dimensions="3">
    <use-data name="Velocity" />
    <use-data name="Pressure" />
  </mesh>

  <participant name="Fluid1DRight">
    <provide-mesh name="Fluid1DRight-Mesh" />
    <receive-mesh name="Fluid1DLeft-Mesh" from="Fluid1DLeft" api-access="false" />
    <write-data name="Pressure" mesh="Fluid1DRight-Mesh" />
    <read-data name="Velocity" mesh="Fluid1DRight-Mesh" />
    <mapping:nearest-neighbor
      direction="read"
      from="Fluid1DLeft-Mesh"
      to="Fluid1DRight-Mesh"
      constraint="consistent" />
    <export:vtu directory="precice-exports" />
  </participant>

  <participant name="Fluid1DLeft">
    <provide-mesh name="Fluid1DLeft-Mesh" />
    <receive-mesh name="Fluid1DRight-Mesh" from="Fluid1DRight" api-access="false" />
    <read-data name="Pressure" mesh="Fluid1DLeft-Mesh" />
    <write-data name="Velocity" mesh="Fluid1DLeft-Mesh" />
    <mapping:nearest-neighbor
      direction="read"
      from="Fluid1DRight-Mesh"
      to="Fluid1DLeft-Mesh"
      constraint="consistent" />
    <export:vtu directory="precice-exports" />
  </participant>

  <m2n:sockets acceptor="Fluid1DRight" connector="Fluid1DLeft" exchange-directory=".." />

  <coupling-scheme:parallel-implicit>
    <time-window-size value="0.01" />
    <max-time value="5.0" />
    <participants first="Fluid1DLeft" second="Fluid1DRight" />
    <exchange data="Velocity" mesh="Fluid1DLeft-Mesh" from="Fluid1DLeft" to="Fluid1DRight" />
    <exchange data="Pressure" mesh="Fluid1DRight-Mesh" from="Fluid1DRight" to="Fluid1DLeft" />
    <max-iterations value="100" />
    <relative-convergence-measure limit="1.0e-3" data="Velocity" mesh="Fluid1DLeft-Mesh" />
    <relative-convergence-measure limit="1.0e-3" data="Pressure" mesh="Fluid1DRight-Mesh" />
    <acceleration:aitken>
      <data mesh="Fluid1DLeft-Mesh" name="Velocity" />
      <data mesh="Fluid1DRight-Mesh" name="Pressure" />
      <initial-relaxation value="1.0" />
    </acceleration:aitken>
  </coupling-scheme:parallel-implicit>
</precice-configuration>
