<?xml version="1.0" encoding="UTF-8" ?>
<precice-configuration experimental="true">
  <log>
    <sink
      filter="%Severity% >= trace and %Rank% = 0"
      format="---[precice] %ColorizedSeverity% %Message%"
      enabled="true" />
  </log>

  <profiling mode="fundamental" synchronize="false" />

  <data:vector name="Velocity" />
  <data:scalar name="Pressure" />

  <mesh name="Fluid3DLeft-Mesh" dimensions="3">
    <use-data name="Velocity" />
    <use-data name="Pressure" />
  </mesh>

  <mesh name="Fluid3DRight-Mesh" dimensions="3">
    <use-data name="Velocity" />
    <use-data name="Pressure" />
  </mesh>

  <participant name="Fluid3DLeft">
    <provide-mesh name="Fluid3DLeft-Mesh" />
    <receive-mesh name="Fluid3DRight-Mesh" from="Fluid3DRight" />
    <write-data name="Pressure" mesh="Fluid3DLeft-Mesh" />
    <read-data name="Velocity" mesh="Fluid3DLeft-Mesh" />
    <mapping:nearest-neighbor
      direction="read"
      from="Fluid3DRight-Mesh"
      to="Fluid3DLeft-Mesh"
      constraint="consistent" />
    <export:vtu directory="precice-exports" />
  </participant>

  <participant name="Fluid3DRight">
    <provide-mesh name="Fluid3DRight-Mesh" />
    <receive-mesh name="Fluid3DLeft-Mesh" from="Fluid3DLeft" />
    <read-data name="Pressure" mesh="Fluid3DRight-Mesh" />
    <write-data name="Velocity" mesh="Fluid3DRight-Mesh" />
    <mapping:nearest-neighbor
      direction="read"
      from="Fluid3DLeft-Mesh"
      to="Fluid3DRight-Mesh"
      constraint="consistent" />
    <export:vtu directory="precice-exports" />
  </participant>

  <m2n:sockets acceptor="Fluid3DLeft" connector="Fluid3DRight" exchange-directory=".." />

  <coupling-scheme:serial-explicit>
    <time-window-size value="0.01" />
    <max-time value="20.0" />
    <participants first="Fluid3DLeft" second="Fluid3DRight" />
    <exchange data="Velocity" mesh="Fluid3DRight-Mesh" from="Fluid3DRight" to="Fluid3DLeft" />
    <exchange data="Pressure" mesh="Fluid3DLeft-Mesh" from="Fluid3DLeft" to="Fluid3DRight" />
  </coupling-scheme:serial-explicit>

</precice-configuration>
