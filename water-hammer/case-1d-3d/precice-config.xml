<?xml version="1.0" encoding="UTF-8" ?>
<precice-configuration experimental="true">
  <log>
    <sink
      filter="%Severity% >= trace and %Rank% = 0"
      format="---[precice] %ColorizedSeverity% %Message%"
      enabled="true" />
  </log>

  <profiling mode="fundamental" synchronize="false" />

  <data:vector name="Velocity" />
  <data:scalar name="Pressure" />

  <mesh name="Fluid1D-Mesh" dimensions="3">
    <use-data name="Velocity" />
    <use-data name="Pressure" />
  </mesh>

  <mesh name="Fluid3D-Mesh" dimensions="3">
    <use-data name="Velocity" />
    <use-data name="Pressure" />
  </mesh>

  <participant name="Fluid1D">
    <provide-mesh name="Fluid1D-Mesh" />
    <receive-mesh name="Fluid3D-Mesh" from="Fluid3D" />
    <write-data name="Pressure" mesh="Fluid1D-Mesh" />
    <read-data name="Velocity" mesh="Fluid1D-Mesh" />
    <mapping:axial-geometric-multiscale
      direction="read"
      multiscale-type="collect"
      multiscale-radius="1.0"
      multiscale-axis="y"
      from="Fluid3D-Mesh"
      to="Fluid1D-Mesh"
      constraint="consistent" />
    <export:vtu directory="precice-exports" />
  </participant>

  <participant name="Fluid3D">
    <provide-mesh name="Fluid3D-Mesh" />
    <receive-mesh name="Fluid1D-Mesh" from="Fluid1D" />
    <read-data name="Pressure" mesh="Fluid3D-Mesh" />
    <write-data name="Velocity" mesh="Fluid3D-Mesh" />
    <mapping:nearest-neighbor
      direction="read"
      from="Fluid1D-Mesh"
      to="Fluid3D-Mesh"
      constraint="consistent" />
    <export:vtu directory="precice-exports" />
  </participant>

  <m2n:sockets acceptor="Fluid1D" connector="Fluid3D" exchange-directory=".." />

  <coupling-scheme:serial-implicit>
    <time-window-size value="0.005" />
    <max-time value="20.0" />
    <participants first="Fluid1D" second="Fluid3D" />
    <exchange data="Velocity" mesh="Fluid3D-Mesh" from="Fluid3D" to="Fluid1D" />
    <exchange data="Pressure" mesh="Fluid1D-Mesh" from="Fluid1D" to="Fluid3D" />
    <max-iterations value="100" />
    <relative-convergence-measure limit="1.0e-3" data="Velocity" mesh="Fluid3D-Mesh" />
    <acceleration:IQN-ILS>
      <data mesh="Fluid3D-Mesh" name="Velocity" />
      <preconditioner type="residual-sum" />
      <initial-relaxation value="1.0" />
      <max-used-iterations value="3" />
      <time-windows-reused value="10" />
      <filter type="QR1" limit="1e-6" />
    </acceleration:IQN-ILS>
  </coupling-scheme:serial-implicit>
</precice-configuration>
