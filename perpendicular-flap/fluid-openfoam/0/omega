FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    object k;
}

dimensions [ 0 0 -1 0 0 0 0 ];

internalField uniform 10;

boundaryField
{

    inlet
    {
        type fixedValue;
        value $internalField;
    }

    outlet
    {
        type inletOutlet;
        inletValue $internalField;
        value $internalField;
    }

    flap
    {
        type omegaWallFunction;
        value $internalField;
    }

    frontAndBack
    {
        type empty;
    }

    upperWall
    {
        type zeroGradient;
    }

    lowerWall
    {
        type zeroGradient;
    }

}

