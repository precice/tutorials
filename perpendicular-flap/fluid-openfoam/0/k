FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 50;

boundaryField
{

    inlet
    {
        type fixedValue;
        value $internalField;
    }

    outlet
    {
        type inletOutlet;
        inletValue $internalField;
        value $internalField;
    }

    flap
    {
        type kqRWallFunction;
        value $internalField;
    }

    frontAndBack
    {
        type empty;
    }

    upperWall
    {
        type zeroGradient;
    }

    lowerWall
    {
        type zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}


