<?xml version="1.0" encoding="UTF-8" ?>
<precice-configuration>
  <log>
    <sink
      filter="%Severity% > debug and %Rank% = 0"
      format="---[precice] %ColorizedSeverity% %Message%"
      enabled="true" />
  </log>

  <profiling mode="fundamental" synchronize="false" />

  <data:vector name="Force" />
  <data:vector name="Displacement" />

  <mesh name="Dirichlet-Mesh" dimensions="3">
    <use-data name="Force" />
    <use-data name="Displacement" />
  </mesh>

  <mesh name="Neumann-Mesh" dimensions="3">
    <use-data name="Displacement" />
    <use-data name="Force" />
  </mesh>

  <participant name="Dirichlet">
    <provide-mesh name="Dirichlet-Mesh" />
    <receive-mesh name="Neumann-Mesh" from="Neumann" />
    <write-data name="Force" mesh="Dirichlet-Mesh" />
    <read-data name="Displacement" mesh="Dirichlet-Mesh" />
    <mapping:nearest-neighbor
      direction="write"
      from="Dirichlet-Mesh"
      to="Neumann-Mesh"
      constraint="conservative" />
    <mapping:nearest-neighbor
      direction="read"
      from="Neumann-Mesh"
      to="Dirichlet-Mesh"
      constraint="consistent" />
  </participant>

  <participant name="Neumann">
    <provide-mesh name="Neumann-Mesh" />
    <write-data name="Displacement" mesh="Neumann-Mesh" />
    <read-data name="Force" mesh="Neumann-Mesh" />
  </participant>

  <m2n:sockets acceptor="Dirichlet" connector="Neumann" exchange-directory="../" />

  <coupling-scheme:parallel-implicit>
    <participants first="Dirichlet" second="Neumann" />
    <max-time-windows value="50" />
    <time-window-size value="1e-2" />
    <exchange data="Displacement" mesh="Neumann-Mesh" from="Neumann" to="Dirichlet" />
    <exchange data="Force" mesh="Neumann-Mesh" from="Dirichlet" to="Neumann" />
    <max-iterations value="50" />
    <relative-convergence-measure limit="1e-4" data="Displacement" mesh="Neumann-Mesh" />
    <relative-convergence-measure limit="1e-4" data="Force" mesh="Neumann-Mesh" />
    <acceleration:IQN-ILS>
      <data name="Displacement" mesh="Neumann-Mesh" />
      <data name="Force" mesh="Neumann-Mesh" />
      <preconditioner type="residual-sum" />
      <filter type="QR2" limit="1e-3" />
      <initial-relaxation value="0.1" />
      <max-used-iterations value="60" />
      <time-windows-reused value="10" />
    </acceleration:IQN-ILS>
  </coupling-scheme:parallel-implicit>
</precice-configuration>
