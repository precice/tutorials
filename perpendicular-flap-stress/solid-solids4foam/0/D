{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      D;
}

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    interface
    {
        type            solidTraction;
        tractionField   solidTraction;
        pressure        uniform 0;
        value           uniform (0 0 0);
    }
    bottom
