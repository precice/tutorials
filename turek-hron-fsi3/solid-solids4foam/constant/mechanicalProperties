FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      mechanicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

planeStress no;

mechanical
(
    rubber
    {
        type    neoHookeanElastic;
        rho     rho [1 -3 0 0 0 0 0] 1000;
        E       E [1 -1 -2 0 0 0 0] 5.6e6;
        nu      nu [0 0 0 0 0 0 0] 0.4;
    }
);

